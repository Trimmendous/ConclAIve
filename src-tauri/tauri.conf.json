{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConclAIve",
  "version": "0.1.0",
  "identifier": "com.trimendous.conclaive",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ConclAIve",
        "width": 1400,
        "height": 900,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
